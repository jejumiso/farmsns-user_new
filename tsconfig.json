{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "#app": ["node_modules/nuxt/dist/app/index.d.ts"],
      "#app/*": ["node_modules/nuxt/dist/app/*"],
      "~/*": ["./*"],
      "@/*": ["./*"]
    },
    "types": ["nuxt", "node"] 
  },
  "include": [
    "nuxt.config.ts",
    "**/*.ts",
    "**/*.vue",
    "types",
    "nuxt.d.ts",
    "globals.d.ts",
    "**/*.vue"
  ]
}
